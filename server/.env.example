# Copy to .env for local development. On cPanel, set these as
# environment variables in "Setup Node.js App" instead.

# MySQL (on cPanel the names are prefixed with your username, e.g. khanz_olive)
DB_HOST=localhost
DB_PORT=3306
DB_USER=olive_user
DB_PASSWORD=change-me
DB_NAME=olive_spa

# Long random string used to sign admin sessions (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin account. Created automatically on startup only while no admin
# exists yet; remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Olive Spa Admin

# Used to work out "today" for bookings and stats
SPA_TIMEZONE=Africa/Juba

# Local development only
PORT=5000
